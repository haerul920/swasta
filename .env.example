# Template Konfigurasi Swasana
# Salin variabel di bawah ini ke dalam file `local.properties` (jangan pernah di-commit!)
# atau set sebagai Environment Variable sistem.

# 1. Lokasi Android SDK (otomatis dibuat oleh Android Studio / run-windows.ps1)
# sdk.dir=C\:\\Users\\haeru\\AppData\\Local\\Android\\Sdk

# 2. API Kualitas Udara (pilih salah satu atau isi keduanya untuk fallback otomatis)
WAQI_TOKEN=
OPENWEATHER_API_KEY=
DEFAULT_AQ_PROVIDER=waqi

# 3. Peta Radar (jika MAPS_API_KEY kosong, aplikasi otomatis memakai OpenStreetMap gratis tanpa kartu kredit)
MAPS_API_KEY=

# 4. Login Google / Credential Manager (Web Client ID OAuth 2.0 dari Firebase / Google Cloud)
GOOGLE_WEB_CLIENT_ID=

# 5. Supabase Storage (Alternatif gratis tanpa kartu kredit untuk upload foto laporan warga)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=swasana-reports

# 6. Penandatanganan Rilis / Release Signing (opsional, hanya untuk build release / bundleRelease)
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
